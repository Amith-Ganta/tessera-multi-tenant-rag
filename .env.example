DEEPSEEK_API_KEY=
OPENAI_API_KEY=
TAVILY_API_KEY=

# Deployment mode: "dev" (default) or "prod".
# In prod the app refuses to start unless TESSERA_SESSION_SECRET is set to a strong non-default value.
TESSERA_ENV=

# Secret used to sign session tokens. Required in prod.
# Leave blank in local dev to use the built-in insecure default.
TESSERA_SESSION_SECRET=

# Hard cap on output tokens per answer (integer, default 1024).
TESSERA_MAX_OUTPUT_TOKENS=

# Soft daily spend ceiling in USD (float, default 5.0).
# Set to 0 to disable the cap.
TESSERA_DAILY_SPEND_USD_CAP=

# --- Observability / tracing (all optional) ---
# Per-stage timing always runs in-process. The keys below only enable optional
# span export to external tracing backends; with them blank the request path is
# unchanged and never depends on a network call.

# Emit one span per RAG stage to LangSmith when this is set to "1"/"true".
TESSERA_STAGE_SPANS=

# Langfuse credentials. Tracing to Langfuse activates only when BOTH keys are set.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Langfuse host URL. Either variable works; LANGFUSE_HOST wins if both are set,
# otherwise LANGFUSE_BASE_URL is used. Defaults to https://cloud.langfuse.com.
LANGFUSE_HOST=
LANGFUSE_BASE_URL=
